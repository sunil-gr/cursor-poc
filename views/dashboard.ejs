<!-- Modal for Sensitive Keywords Info (true dialog, overlays page) -->
<div id="sensitiveKeywordsModal" class="modal" style="display:none; position:fixed; z-index:9999; left:0; top:0; width:100vw; height:100vh; background:rgba(0,0,0,0.4); align-items:center; justify-content:center;" data-keywords='["username","user","password","pass","database","db","token","jwt","secret","credential","auth","security","access","apikey","api_key","refresh","session","cookie","bearer"]'>
  <div class="modal-content" style="background:#fff; padding:2em; border-radius:8px; max-width:600px; margin:10vh auto; position:relative;">
    <span class="close" id="closeSensitiveKeywordsModal">&times;</span>
    <h3>Keywords Used</h3>
    <p>These are the keywords the system uses to scan your logs for potentially keyword information. If any of these keywords are found, they will be highlighted in the report below.</p>
    <div id="sensitiveKeywordsTags" class="tags-container">
      <!-- Tags will be populated by JS -->
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var infoIcon = document.getElementById('sensitiveKeywordsInfoIcon');
    var modal = document.getElementById('sensitiveKeywordsModal');
    var closeBtn = document.getElementById('closeSensitiveKeywordsModal');
    if (infoIcon && modal && closeBtn) {
      infoIcon.onclick = function() { modal.style.display = 'flex'; };
      closeBtn.onclick = function() { modal.style.display = 'none'; };
      window.onclick = function(event) { if (event.target == modal) { modal.style.display = 'none'; } };
      // Populate tags
      var tagsContainer = document.getElementById('sensitiveKeywordsTags');
      var keywords = [];
      var dataAttr = modal.getAttribute('data-keywords');
      try {
        keywords = dataAttr ? JSON.parse(dataAttr) : [];
      } catch (e) { keywords = []; }
      if (Array.isArray(keywords) && keywords.length > 0) {
        tagsContainer.innerHTML = '';
        keywords.forEach(function(kw) {
          var tag = document.createElement('span');
          tag.className = 'tag';
          tag.textContent = kw;
          tagsContainer.appendChild(tag);
        });
      } else {
        tagsContainer.innerHTML = '<span style="color:#888;">No keywords found.</span>';
      }
    }
  });
</script>
<style>
  .modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.4);
    align-items: center;
    justify-content: center;
  }
  .modal-content {
    background: #fff;
    padding: 2em;
    border-radius: 8px;
    max-width: 600px;
    margin: 10vh auto;
    position: relative;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  }
  .close {
    color: #aaa;
    position: absolute;
    top: 10px;
    right: 18px;
    font-size: 1.5em;
    font-weight: bold;
    cursor: pointer;
  }
  .close:hover {
    color: #333;
  }
  .tags-container {
    margin-top: 1em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }
  .tag {
    background: #e3f2fd;
    color: #1976d2;
    border-radius: 16px;
    padding: 0.3em 1em;
    font-size: 0.95em;
    display: inline-block;
    margin-bottom: 0.3em;
  }
</style> 